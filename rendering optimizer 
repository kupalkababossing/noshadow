
local Lighting = game:GetService("Lighting")
local Manager = getgenv().JOSHZZ_SHARED_EFFECT_MANAGER

if not Manager then
    error("JOSHZZ SharedEffectManager is not initialized")
end

local Owner = {}
local Enabled = false
local Connections = {}
local EffectTypes = {
    BlurEffect = true,
    ColorCorrectionEffect = true,
    DepthOfFieldEffect = true
}

local function ProcessEffect(Effect)
    if not Enabled or not EffectTypes[Effect.ClassName] then
        return
    end

    if not Connections[Effect] then
        Connections[Effect] = Effect:GetPropertyChangedSignal("Enabled"):Connect(function()
            if Enabled and Effect.Enabled then
                Manager.Claim(Owner, Effect, "Enabled", false)
            end
        end)
    end

    if Effect.Enabled then
        Manager.Claim(Owner, Effect, "Enabled", false)
    end
end

local function Scan()
    for _, Effect in ipairs(Lighting:GetDescendants()) do
        ProcessEffect(Effect)
    end
end

local function SetRenderingOptimizer(State)
    Enabled = State == true

    if Enabled then
        Scan()
    else
        for Effect, Connection in pairs(Connections) do
            Connection:Disconnect()
            Connections[Effect] = nil
        end

        Manager.ReleaseOwner(Owner)
    end
end

Lighting.DescendantAdded:Connect(function(Effect)
    if Enabled then
        ProcessEffect(Effect)
    end
end)

task.spawn(function()
    while true do
        task.wait(2)

        if Enabled then
            Scan()
        end
    end
end)

return SetRenderingOptimizer
