
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")

local Env = (getgenv and getgenv()) or _G
local Manager = Env.JOSHZZ_SHARED_EFFECT_MANAGER

assert(Manager, "JOSHZZ_SHARED_EFFECT_MANAGER not found")

local Owner = "GameMode"
local ME = Players.LocalPlayer
local CanBeEnabled = {"ParticleEmitter", "Trail", "Smoke", "Fire", "Sparkles"}

if not _G.Ignore then
    _G.Ignore = {}
end

if _G.ConsoleLogs == nil then
    _G.ConsoleLogs = false
end

if not _G.Settings then
    _G.Settings = {
        Players = {
            ["Ignore Me"] = true,
            ["Ignore Others"] = true,
            ["Ignore Tools"] = true
        },
        Meshes = {
            NoMesh = false,
            NoTexture = false,
            Destroy = false
        },
        Images = {
            Invisible = true,
            Destroy = false
        },
        Explosions = {
            Smaller = true,
            Invisible = false,
            Destroy = false
        },
        Particles = {
            Invisible = true,
            Destroy = false
        },
        TextLabels = {
            LowerQuality = false,
            Invisible = false,
            Destroy = false
        },
        MeshParts = {
            LowerQuality = true,
            Invisible = false,
            NoTexture = false,
            NoMesh = false,
            Destroy = false
        },
        Other = {
            ["FPS Cap"] = true,
            ["No Camera Effects"] = true,
            ["No Clothes"] = true,
            ["Low Water Graphics"] = true,
            ["No Shadows"] = true,
            ["Low Rendering"] = true,
            ["Low Quality Parts"] = true,
            ["Low Quality Models"] = true,
            ["Reset Materials"] = true,
            ["Lower Quality MeshParts"] = true,
            ClearNilInstances = false
        }
    }
end

local Active = false
local Claimed = setmetatable({}, {__mode = "k"})
local HiddenOriginals = {}
local RenderingOriginals = {}
local OriginalFPSCap
local FPSChanged = false
local AddedConnection

local function Claim(Inst, Property, Value)
    if not Inst or not Inst.Parent then
        return
    end

    local Properties = Claimed[Inst]

    if not Properties then
        Properties = {}
        Claimed[Inst] = Properties
    end

    if Properties[Property] then
        return
    end

    local Success = pcall(function()
        Manager:Claim(Owner, Inst, Property, Value)
    end)

    if Success then
        Properties[Property] = true
    end
end

local function SetHidden(Inst, Property, Value)
    if not sethiddenproperty then
        return
    end

    local Key = Inst

    if not HiddenOriginals[Key] then
        HiddenOriginals[Key] = {}
    end

    if HiddenOriginals[Key][Property] == nil then
        if gethiddenproperty then
            local Success, Original = pcall(gethiddenproperty, Inst, Property)

            if Success then
                HiddenOriginals[Key][Property] = Original
            else
                return
            end
        else
            return
        end
    end

    pcall(sethiddenproperty, Inst, Property, Value)
end

local function RestoreHidden()
    if not sethiddenproperty then
        HiddenOriginals = {}
        return
    end

    for Inst, Properties in pairs(HiddenOriginals) do
        for Property, Original in pairs(Properties) do
            pcall(sethiddenproperty, Inst, Property, Original)
        end
    end

    HiddenOriginals = {}
end

local function PartOfCharacter(Inst)
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= ME and Player.Character and Inst:IsDescendantOf(Player.Character) then
            return true
        end
    end

    return false
end

local function DescendantOfIgnore(Inst)
    for _, Ignored in ipairs(_G.Ignore) do
        if Inst:IsDescendantOf(Ignored) then
            return true
        end
    end

    return false
end

local function CheckIfBad(Inst)
    if not Active then
        return
    end

    local Settings = _G.Settings
    local PlayerSettings = Settings.Players or {}

    if Inst:IsDescendantOf(Players) then
        return
    end

    if PlayerSettings["Ignore Others"] and PartOfCharacter(Inst) then
        return
    end

    if PlayerSettings["Ignore Me"] and ME.Character and Inst:IsDescendantOf(ME.Character) then
        return
    end

    if PlayerSettings["Ignore Tools"] and (Inst:IsA("BackpackItem") or Inst:FindFirstAncestorWhichIsA("BackpackItem")) then
        return
    end

    if type(_G.Ignore) == "table" then
        if table.find(_G.Ignore, Inst) or DescendantOfIgnore(Inst) then
            return
        end
    end

    if Inst:IsA("DataModelMesh") then
        if Inst:IsA("SpecialMesh") then
            if Settings.Meshes.NoMesh then
                Claim(Inst, "MeshId", "")
            end

            if Settings.Meshes.NoTexture then
                Claim(Inst, "TextureId", "")
            end
        end

        if Settings.Meshes.Destroy or Settings["No Meshes"] then
            if Inst:IsA("SpecialMesh") then
                Claim(Inst, "MeshId", "")
                Claim(Inst, "TextureId", "")
            end
        end

    elseif Inst:IsA("FaceInstance") then
        if Settings.Images.Invisible or Settings.Images.Destroy then
            Claim(Inst, "Transparency", 1)
            Claim(Inst, "Shiny", 1)
        end

        if Settings.Images.LowDetail then
            Claim(Inst, "Shiny", 1)
        end

    elseif Inst:IsA("ShirtGraphic") then
        if Settings.Images.Invisible or Settings.Images.Destroy then
            Claim(Inst, "Graphic", "")
        end

    elseif table.find(CanBeEnabled, Inst.ClassName) then
        if Settings["Invisible Particles"]
            or Settings["No Particles"]
            or (Settings.Other and Settings.Other["Invisible Particles"])
            or (Settings.Other and Settings.Other["No Particles"])
            or (Settings.Particles and (Settings.Particles.Invisible or Settings.Particles.Destroy)) then

            Claim(Inst, "Enabled", false)
        end

    elseif Inst:IsA("PostEffect") then
        if Settings["No Camera Effects"] or (Settings.Other and Settings.Other["No Camera Effects"]) then
            Claim(Inst, "Enabled", false)
        end

    elseif Inst:IsA("Explosion") then
        if Settings["Smaller Explosions"]
            or (Settings.Other and Settings.Other["Smaller Explosions"])
            or (Settings.Explosions and Settings.Explosions.Smaller) then

            Claim(Inst, "BlastPressure", 1)
            Claim(Inst, "BlastRadius", 1)
        end

        if Settings["Invisible Explosions"]
            or (Settings.Other and Settings.Other["Invisible Explosions"])
            or (Settings.Explosions and Settings.Explosions.Invisible)
            or Settings["No Explosions"]
            or (Settings.Other and Settings.Other["No Explosions"])
            or (Settings.Explosions and Settings.Explosions.Destroy) then

            Claim(Inst, "BlastPressure", 1)
            Claim(Inst, "BlastRadius", 1)
            Claim(Inst, "Visible", false)
        end

    elseif Inst:IsA("Clothing") then
        if Settings["No Clothes"] or (Settings.Other and Settings.Other["No Clothes"]) then
            if Inst:IsA("Shirt") then
                Claim(Inst, "ShirtTemplate", "")
            elseif Inst:IsA("Pants") then
                Claim(Inst, "PantsTemplate", "")
            elseif Inst:IsA("ShirtGraphic") then
                Claim(Inst, "Graphic", "")
            end
        end

    elseif Inst:IsA("SurfaceAppearance") then
        if Settings["No Clothes"] or (Settings.Other and Settings.Other["No Clothes"]) then
            Claim(Inst, "ColorMap", "")
            Claim(Inst, "MetalnessMap", "")
            Claim(Inst, "NormalMap", "")
            Claim(Inst, "RoughnessMap", "")
        end

    elseif Inst:IsA("BaseWrap") then
        if Settings["No Clothes"] or (Settings.Other and Settings.Other["No Clothes"]) then
            Claim(Inst, "Enabled", false)
        end

    elseif Inst:IsA("BasePart") and not Inst:IsA("MeshPart") then
        if Settings["Low Quality Parts"] or (Settings.Other and Settings.Other["Low Quality Parts"]) then
            Claim(Inst, "Material", Enum.Material.Plastic)
            Claim(Inst, "Reflectance", 0)
        end

    elseif Inst:IsA("TextLabel") and Inst:IsDescendantOf(workspace) then
        if Settings["Lower Quality TextLabels"]
            or (Settings.Other and Settings.Other["Lower Quality TextLabels"])
            or (Settings.TextLabels and Settings.TextLabels.LowerQuality) then

            Claim(Inst, "Font", Enum.Font.SourceSans)
            Claim(Inst, "TextScaled", false)
            Claim(Inst, "RichText", false)
            Claim(Inst, "TextSize", 14)
        end

        if Settings["Invisible TextLabels"]
            or (Settings.Other and Settings.Other["Invisible TextLabels"])
            or (Settings.TextLabels and Settings.TextLabels.Invisible)
            or Settings["No TextLabels"]
            or (Settings.Other and Settings.Other["No TextLabels"])
            or (Settings.TextLabels and Settings.TextLabels.Destroy) then

            Claim(Inst, "Visible", false)
        end

    elseif Inst:IsA("Model") then
        if Settings["Low Quality Models"] or (Settings.Other and Settings.Other["Low Quality Models"]) then
            pcall(function()
                Claim(Inst, "LevelOfDetail", Enum.ModelLevelOfDetail.StreamingMesh)
            end)
        end

    elseif Inst:IsA("MeshPart") then
        if Settings["Low Quality MeshParts"]
            or (Settings.Other and Settings.Other["Low Quality MeshParts"])
            or (Settings.MeshParts and Settings.MeshParts.LowerQuality) then

            Claim(Inst, "RenderFidelity", Enum.RenderFidelity.Performance)
            Claim(Inst, "Reflectance", 0)
            Claim(Inst, "Material", Enum.Material.Plastic)
        end

        if Settings["Invisible MeshParts"]
            or (Settings.Other and Settings.Other["Invisible MeshParts"])
            or (Settings.MeshParts and Settings.MeshParts.Invisible)
            or Settings["No MeshParts"]
            or (Settings.Other and Settings.Other["No MeshParts"])
            or (Settings.MeshParts and Settings.MeshParts.Destroy) then

            Claim(Inst, "Transparency", 1)
            Claim(Inst, "RenderFidelity", Enum.RenderFidelity.Performance)
            Claim(Inst, "Reflectance", 0)
            Claim(Inst, "Material", Enum.Material.Plastic)
        end

        if Settings.MeshParts and Settings.MeshParts.NoTexture then
            Claim(Inst, "TextureID", "")
        end

        if Settings.MeshParts and Settings.MeshParts.NoMesh then
            pcall(function()
                Claim(Inst, "MeshId", "")
            end)
        end
    end
end

local function ApplyGlobalSettings()
    local Settings = _G.Settings
    local Other = Settings.Other or {}

    if Settings["Low Water Graphics"] or Other["Low Water Graphics"] then
        local Terrain = workspace:FindFirstChildOfClass("Terrain")

        if not Terrain then
            repeat
                task.wait()
                Terrain = workspace:FindFirstChildOfClass("Terrain")
            until Terrain or not Active
        end

        if Terrain and Active then
            Claim(Terrain, "WaterWaveSize", 0)
            Claim(Terrain, "WaterWaveSpeed", 0)
            Claim(Terrain, "WaterReflectance", 0)
            Claim(Terrain, "WaterTransparency", 0)
            SetHidden(Terrain, "Decoration", false)

            if _G.ConsoleLogs then
                warn("Low Water Graphics Enabled")
            end
        end
    end

    if Settings["No Shadows"] or Other["No Shadows"] then
        Claim(Lighting, "GlobalShadows", false)
        Claim(Lighting, "FogEnd", 9e9)
        Claim(Lighting, "ShadowSoftness", 0)
        SetHidden(Lighting, "Technology", 2)

        if _G.ConsoleLogs then
            warn("No Shadows Enabled")
        end
    end

    if Settings["Low Rendering"] or Other["Low Rendering"] then
        pcall(function()
            local Rendering = settings().Rendering

            if not RenderingOriginals.QualityLevel then
                RenderingOriginals.QualityLevel = Rendering.QualityLevel
                RenderingOriginals.MeshPartDetailLevel = Rendering.MeshPartDetailLevel
            end

            Rendering.QualityLevel = 1
            Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        end)

        if _G.ConsoleLogs then
            warn("Low Rendering Enabled")
        end
    end

    if Settings["Reset Materials"] or Other["Reset Materials"] then
        Claim(MaterialService, "Use2022Materials", false)

        if _G.ConsoleLogs then
            warn("Reset Materials Enabled")
        end
    end

    local FPSSetting = Settings["FPS Cap"]

    if FPSSetting == nil then
        FPSSetting = Other["FPS Cap"]
    end

    if FPSSetting then
        if setfpscap then
            if not FPSChanged and getfpscap then
                local Success, Value = pcall(getfpscap)

                if Success then
                    OriginalFPSCap = Value
                    FPSChanged = true
                end
            end

            if type(FPSSetting) == "string" or type(FPSSetting) == "number" then
                pcall(setfpscap, tonumber(FPSSetting))
            elseif FPSSetting == true then
                pcall(setfpscap, 1e6)
            end
        else
            warn("FPS Cap Failed")
        end
    end

    if Other.ClearNilInstances then
        warn("ClearNilInstances skipped because it cannot be restored.")
    end
end

local function RestoreExternalSettings()
    if RenderingOriginals.QualityLevel ~= nil then
        pcall(function()
            local Rendering = settings().Rendering
            Rendering.QualityLevel = RenderingOriginals.QualityLevel
            Rendering.MeshPartDetailLevel = RenderingOriginals.MeshPartDetailLevel
        end)
    end

    RenderingOriginals = {}

    if FPSChanged and OriginalFPSCap ~= nil and setfpscap then
        pcall(setfpscap, OriginalFPSCap)
    end

    OriginalFPSCap = nil
    FPSChanged = false

    RestoreHidden()
end

local function Enable()
    if Active then
        return
    end

    Active = true
    Claimed = setmetatable({}, {__mode = "k"})

    if not game:IsLoaded() then
        repeat
            task.wait()
        until game:IsLoaded() or not Active
    end

    if not Active then
        return
    end

    ApplyGlobalSettings()

    local Descendants = game:GetDescendants()

    if _G.ConsoleLogs then
        warn("Checking " .. #Descendants .. " Instances...")
    end

    for _, Inst in ipairs(Descendants) do
        if not Active then
            break
        end

        CheckIfBad(Inst)
    end

    if Active then
        warn("FPS Booster Loaded!")
    end
end

local function Disable()
    if not Active then
        return
    end

    Active = false

    pcall(function()
        Manager:ReleaseOwner(Owner)
    end)

    RestoreExternalSettings()

    Claimed = setmetatable({}, {__mode = "k"})
end

if not AddedConnection then
    AddedConnection = game.DescendantAdded:Connect(function(Inst)
        task.wait(_G.LoadedWait or 1)

        if Active then
            CheckIfBad(Inst)
        end
    end)
end

return function(State)
    if State then
        Enable()
    else
        Disable()
    end
end
