
local Workspace = game:GetService("Workspace")
local Manager = getgenv().JOSHZZ_SHARED_EFFECT_MANAGER

if not Manager then
    error("SharedEffectManager is not initialized")
end

local Owner = {}
local Enabled = false

local EffectTypes = {
    ParticleEmitter = true,
    Trail = true,
    Beam = true,
    Fire = true,
    Sparkles = true
}

local function ProcessEffect(Effect)
    if EffectTypes[Effect.ClassName] then
        Manager.Claim(Owner, Effect, "Enabled", false)
    end
end

local function SetParticleOptimizer(State)
    Enabled = State == true

    if Enabled then
        for _, Effect in ipairs(Workspace:GetDescendants()) do
            ProcessEffect(Effect)
        end
    else
        Manager.ReleaseOwner(Owner)
    end
end

Workspace.DescendantAdded:Connect(function(Effect)
    if Enabled then
        ProcessEffect(Effect)
    end
end)

return SetParticleOptimizer
