
local Workspace = game:GetService("Workspace")
local Manager = getgenv().JOSHZZ_SHARED_EFFECT_MANAGER

if not Manager then
    error("JOSHZZ SharedEffectManager is not initialized")
end

local Owner = {}
local Enabled = false

local function ProcessEffect(Effect)
    if Effect:IsA("MeshPart") then
        Manager.Claim(Owner, Effect, "RenderFidelity", Enum.MeshPartRenderFidelity.Performance)
    end
end

local function SetMeshOptimizer(State)
    Enabled = State == true

    if Enabled then
        for _, Effect in ipairs(Workspace:GetDescendants()) do
            ProcessEffect(Effect)
        end
    else
        Manager.ReleaseOwner(Owner)
    end
end

Workspace.DescendantAdded:Connect(function(Effect)
    if Enabled then
        ProcessEffect(Effect)
    end
end)

return SetMeshOptimizer
