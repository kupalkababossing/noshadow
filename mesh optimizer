local Workspace = game:GetService("Workspace")
local Manager = getgenv().JOSHZZ_SHARED_EFFECT_MANAGER

if not Manager then
    error("JOSHZZ SharedEffectManager is not initialized")
end

local Owner = {}
local Enabled = false
local Connections = {}
local Processed = {}

local TextureProperties = {
    "TextureID"
}

local function ProcessMesh(Mesh)
    if not Enabled or not Mesh:IsA("MeshPart") then
        return
    end

    if Processed[Mesh] then
        return
    end

    Processed[Mesh] = true

    for _, Property in ipairs(TextureProperties) do
        local Success, Value = pcall(function()
            return Mesh[Property]
        end)

        if Success and Value ~= "" then
            Manager.Claim(Owner, Mesh, Property, "")
        end
    end

    Connections[Mesh] = Mesh:GetPropertyChangedSignal("TextureID"):Connect(function()
        if Enabled and Mesh.TextureID ~= "" then
            Manager.Claim(Owner, Mesh, "TextureID", "")
        end
    end)
end

local function Scan()
    for _, Object in ipairs(Workspace:GetDescendants()) do
        ProcessMesh(Object)
    end
end

local function SetMeshTextureOptimizer(State)
    Enabled = State == true

    if Enabled then
        Scan()
    else
        for Mesh, Connection in pairs(Connections) do
            Connection:Disconnect()
            Connections[Mesh] = nil
        end

        table.clear(Processed)
        Manager.ReleaseOwner(Owner)
    end
end

Workspace.DescendantAdded:Connect(function(Object)
    if Enabled then
        ProcessMesh(Object)
    end
end)

task.spawn(function()
    while true do
        task.wait(2)

        if Enabled then
            Scan()
        end
    end
end)

return SetMeshTextureOptimizer
