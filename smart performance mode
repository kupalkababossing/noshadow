
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Controller = {}

local Enabled = false
local Level = 1
local Destroyed = false

local OriginalProperties = {}
local Connections = {}

local ModeSettings = {
    [0] = {
        DisableShadows = true,
        DisableParticles = true,
        DisableLights = true,
        DisablePostEffects = true,
        DisableTrails = true,
        DisableBeams = true,
        DisableFire = true,
        DisableSmoke = true,
        DisableSparkles = true,
    },

    [1] = {
        DisableShadows = false,
        DisableParticles = false,
        DisableLights = false,
        DisablePostEffects = false,
        DisableTrails = false,
        DisableBeams = false,
        DisableFire = false,
        DisableSmoke = false,
        DisableSparkles = false,
    },

    [2] = {
        DisableShadows = false,
        DisableParticles = false,
        DisableLights = false,
        DisablePostEffects = false,
        DisableTrails = false,
        DisableBeams = false,
        DisableFire = false,
        DisableSmoke = false,
        DisableSparkles = false,
    },
}

local function SaveProperty(instance, property)
    if not OriginalProperties[instance] then
        OriginalProperties[instance] = {}
    end

    if OriginalProperties[instance][property] == nil then
        local success, value = pcall(function()
            return instance[property]
        end)

        if success then
            OriginalProperties[instance][property] = value
        end
    end
end

local function SetProperty(instance, property, value)
    SaveProperty(instance, property)

    pcall(function()
        instance[property] = value
    end)
end

local function RestoreInstance(instance)
    local properties = OriginalProperties[instance]

    if not properties then
        return
    end

    for property, value in pairs(properties) do
        pcall(function()
            instance[property] = value
        end)
    end

    OriginalProperties[instance] = nil
end

local function RestoreAll()
    for instance in pairs(OriginalProperties) do
        RestoreInstance(instance)
    end
end

local function ApplyInstance(instance)
    if not Enabled or Destroyed then
        return
    end

    local settings = ModeSettings[Level]

    if not settings then
        return
    end

    if instance:IsA("BasePart") then
        if settings.DisableShadows then
            SetProperty(instance, "CastShadow", false)
        end

    elseif instance:IsA("ParticleEmitter") then
        if settings.DisableParticles then
            SetProperty(instance, "Enabled", false)
        end

    elseif instance:IsA("PointLight")
        or instance:IsA("SpotLight")
        or instance:IsA("SurfaceLight") then

        if settings.DisableLights then
            SetProperty(instance, "Enabled", false)
        end

    elseif instance:IsA("PostEffect") then
        if settings.DisablePostEffects then
            SetProperty(instance, "Enabled", false)
        end

    elseif instance:IsA("Trail") then
        if settings.DisableTrails then
            SetProperty(instance, "Enabled", false)
        end

    elseif instance:IsA("Beam") then
        if settings.DisableBeams then
            SetProperty(instance, "Enabled", false)
        end

    elseif instance:IsA("Fire") then
        if settings.DisableFire then
            SetProperty(instance, "Enabled", false)
        end

    elseif instance:IsA("Smoke") then
        if settings.DisableSmoke then
            SetProperty(instance, "Enabled", false)
        end

    elseif instance:IsA("Sparkles") then
        if settings.DisableSparkles then
            SetProperty(instance, "Enabled", false)
        end
    end
end

local function ApplyAll()
    if not Enabled or Destroyed then
        return
    end

    RestoreAll()

    for _, instance in ipairs(Workspace:GetDescendants()) do
        ApplyInstance(instance)
    end

    for _, instance in ipairs(Lighting:GetDescendants()) do
        ApplyInstance(instance)
    end
end

local function ConnectMonitoring()
    if Connections.DescendantAdded then
        Connections.DescendantAdded:Disconnect()
    end

    Connections.DescendantAdded = Workspace.DescendantAdded:Connect(function(instance)
        if Enabled and not Destroyed then
            ApplyInstance(instance)
        end
    end)

    if Connections.LightingAdded then
        Connections.LightingAdded:Disconnect()
    end

    Connections.LightingAdded = Lighting.DescendantAdded:Connect(function(instance)
        if Enabled and not Destroyed then
            ApplyInstance(instance)
        end
    end)
end

function Controller.SetLevel(level)
    if Destroyed then
        return false
    end

    Level = math.clamp(math.floor(tonumber(level) or 1), 0, 2)

    if Enabled then
        ApplyAll()
    end

    return true
end

function Controller.GetLevel()
    return Level
end

function Controller.GetModeName()
    local names = {
        [0] = "High Performance",
        [1] = "Balanced",
        [2] = "Smooth",
    }

    return names[Level]
end

function Controller.SetEnabled(state)
    if Destroyed then
        return false
    end

    Enabled = state == true

    if Enabled then
        ApplyAll()
        ConnectMonitoring()
    else
        RestoreAll()

        for _, connection in pairs(Connections) do
            connection:Disconnect()
        end

        table.clear(Connections)
    end

    return true
end

function Controller.GetEnabled()
    return Enabled
end

function Controller.Destroy()
    if Destroyed then
        return
    end

    Enabled = false
    Destroyed = true

    for _, connection in pairs(Connections) do
        connection:Disconnect()
    end

    table.clear(Connections)
    RestoreAll()
end

return function()
    return Controller
end
