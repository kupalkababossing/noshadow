
local RunService = game:GetService("RunService")

local Active = false
local Connection

local TargetFPS = 999
local LowThreshold = 50
local RecoveryThreshold = 100

local CheckInterval = 2
local LowFPSCount = 0
local StableFPSCount = 0
local LastUpdate = 0

local OriginalQuality
local CurrentQuality
local QualityLevels = Enum.QualityLevel:GetEnumItems()

table.sort(QualityLevels, function(A, B)
    return A.Value < B.Value
end)

local function GetQualityIndex(Value)
    for Index, Quality in ipairs(QualityLevels) do
        if Quality.Value == Value.Value then
            return Index
        end
    end
end

local function SetQuality(Index)
    local Quality = QualityLevels[Index]

    if not Quality then
        return false
    end

    local Success = pcall(function()
        settings().Rendering.QualityLevel = Quality
    end)

    if Success then
        CurrentQuality = Quality
        return true
    end

    return false
end

local function Enable()
    if Active then
        return
    end

    local Success, Quality = pcall(function()
        return settings().Rendering.QualityLevel
    end)

    if not Success or not Quality then
        return
    end

    OriginalQuality = Quality
    CurrentQuality = Quality

    Active = true
    LowFPSCount = 0
    StableFPSCount = 0
    LastUpdate = os.clock()

    Connection = RunService.RenderStepped:Connect(function(DeltaTime)
        if not Active or DeltaTime <= 0 then
            return
        end

        local Now = os.clock()

        if Now - LastUpdate < CheckInterval then
            return
        end

        LastUpdate = Now

        local FPS = 1 / DeltaTime

        if FPS < LowThreshold then
            LowFPSCount += 1
            StableFPSCount = 0
        elseif FPS >= RecoveryThreshold then
            StableFPSCount += 1
            LowFPSCount = 0
        else
            LowFPSCount = 0
            StableFPSCount = 0
        end

        local CurrentIndex = GetQualityIndex(CurrentQuality)

        if not CurrentIndex then
            return
        end

        if LowFPSCount >= 2 then
            SetQuality(math.max(1, CurrentIndex - 1))
            LowFPSCount = 0
        elseif StableFPSCount >= 5 then
            local OriginalIndex = GetQualityIndex(OriginalQuality)

            if OriginalIndex then
                SetQuality(math.min(OriginalIndex, CurrentIndex + 1))
            end

            StableFPSCount = 0
        end
    end)
end

local function Disable()
    if not Active then
        return
    end

    Active = false

    if Connection then
        Connection:Disconnect()
        Connection = nil
    end

    if OriginalQuality then
        pcall(function()
            settings().Rendering.QualityLevel = OriginalQuality
        end)
    end

    OriginalQuality = nil
    CurrentQuality = nil
    LowFPSCount = 0
    StableFPSCount = 0
end

return function(State)
    if State then
        Enable()
    else
        Disable()
    end
end
