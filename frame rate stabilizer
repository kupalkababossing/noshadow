local RunService = game:GetService("RunService")

local Active = false
local Connection
local LastUpdate = 0
local LowFPSCount = 0
local StableFPSCount = 0

local TargetFPS = 999
local CheckInterval = 2
local LowThreshold = 45
local RecoveryThreshold = 90

local OriginalQuality
local CurrentQuality

local function GetQuality()
    local Success, Value = pcall(function()
        return settings().Rendering.QualityLevel
    end)

    if Success then
        return Value
    end
end

local function SetQuality(Value)
    pcall(function()
        settings().Rendering.QualityLevel = Value
    end)
end

local function Enable()
    if Active then
        return
    end

    OriginalQuality = GetQuality()

    if not OriginalQuality then
        return
    end

    CurrentQuality = OriginalQuality
    Active = true
    LastUpdate = 0
    LowFPSCount = 0
    StableFPSCount = 0

    Connection = RunService.RenderStepped:Connect(function(DeltaTime)
        if not Active then
            return
        end

        local Now = os.clock()

        if Now - LastUpdate < CheckInterval then
            return
        end

        LastUpdate = Now

        local FPS = 1 / math.max(DeltaTime, 0.001)

        if FPS < LowThreshold then
            LowFPSCount += 1
            StableFPSCount = 0
        elseif FPS >= RecoveryThreshold then
            StableFPSCount += 1
            LowFPSCount = 0
        else
            LowFPSCount = 0
            StableFPSCount = 0
        end

        if LowFPSCount >= 2 then
            local NewQuality = math.max(1, CurrentQuality.Value - 1)
            CurrentQuality = Enum.QualityLevel.NewQuality
            SetQuality(CurrentQuality)
            LowFPSCount = 0
        elseif StableFPSCount >= 5 then
            local NewQuality = math.min(10, CurrentQuality.Value + 1)
            CurrentQuality = Enum.QualityLevel.NewQuality
            SetQuality(CurrentQuality)
            StableFPSCount = 0
        end
    end)
end

local function Disable()
    if not Active then
        return
    end

    Active = false

    if Connection then
        Connection:Disconnect()
        Connection = nil
    end

    if OriginalQuality then
        SetQuality(OriginalQuality)
    end

    OriginalQuality = nil
    CurrentQuality = nil
end

return function(State)
    if State then
        Enable()
    else
        Disable()
    end
end
