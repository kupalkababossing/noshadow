
local Lighting = game:GetService("Lighting")

local Enabled = false
local SavedState = nil
local Connection = nil

local function SetNoShadows(state)
    Enabled = state == true

    if Enabled then
        if SavedState == nil then
            SavedState = Lighting.GlobalShadows
        end

        Lighting.GlobalShadows = false

        if not Connection then
            Connection = Lighting:GetPropertyChangedSignal("GlobalShadows"):Connect(function()
                if Enabled and Lighting.GlobalShadows then
                    Lighting.GlobalShadows = false
                end
            end)
        end
    else
        if Connection then
            Connection:Disconnect()
            Connection = nil
        end

        if SavedState ~= nil then
            Lighting.GlobalShadows = SavedState
            SavedState = nil
        end
    end
end

return SetNoShadows
