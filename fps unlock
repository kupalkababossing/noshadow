
local Env = (getgenv and getgenv()) or _G

local OriginalFPSCap
local Active = false

local function Enable()
    if Active then
        return
    end

    if not setfpscap or not getfpscap then
        warn("Unlock FPS: FPS functions unavailable")
        return
    end

    local Success, Value = pcall(getfpscap)

    if not Success then
        warn("Unlock FPS: Failed to get original FPS cap")
        return
    end

    OriginalFPSCap = Value

    local Changed = pcall(setfpscap, 999)

    if Changed then
        Active = true
    end
end

local function Disable()
    if not Active then
        return
    end

    if OriginalFPSCap ~= nil and setfpscap then
        pcall(setfpscap, OriginalFPSCap)
    end

    OriginalFPSCap = nil
    Active = false
end

return function(State)
    if State then
        Enable()
    else
        Disable()
    end
end
