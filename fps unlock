local OriginalFPSCap
local Active = false
local TargetFPS = 999

local function Enable()
    if Active then
        return
    end

    if not setfpscap or not getfpscap then
        return
    end

    local Success, Value = pcall(getfpscap)

    if not Success then
        return
    end

    OriginalFPSCap = Value

    local Changed = pcall(setfpscap, TargetFPS)

    if Changed then
        Active = true
    end
end

local function Disable()
    if not Active then
        return
    end

    if OriginalFPSCap ~= nil then
        pcall(setfpscap, OriginalFPSCap)
    end

    OriginalFPSCap = nil
    Active = false
end

return function(State)
    if State then
        Enable()
    else
        Disable()
    end
end
