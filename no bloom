
local Lighting = game:GetService("Lighting")

local Enabled = false
local SavedStates = {}
local Connections = {}

local function ProcessEffect(effect)
    if not effect:IsA("BloomEffect") then
        return
    end

    if SavedStates[effect] == nil then
        SavedStates[effect] = effect.Enabled
    end

    effect.Enabled = false

    if not Connections[effect] then
        Connections[effect] = effect:GetPropertyChangedSignal("Enabled"):Connect(function()
            if Enabled and effect.Enabled then
                effect.Enabled = false
            end
        end)
    end
end

local function SetNoBloom(state)
    Enabled = state == true

    if Enabled then
        for _, effect in ipairs(Lighting:GetDescendants()) do
            ProcessEffect(effect)
        end
    else
        for effect, connection in pairs(Connections) do
            connection:Disconnect()
            Connections[effect] = nil
        end

        for effect, originalState in pairs(SavedStates) do
            if effect.Parent then
                effect.Enabled = originalState
            end

            SavedStates[effect] = nil
        end
    end
end

Lighting.DescendantAdded:Connect(function(effect)
    if Enabled then
        ProcessEffect(effect)
    end
end)

return SetNoBloom
